# Server
HOST=http://localhost
PORT=8000
FRONTEND_URL=http://localhost:3000

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_DATABASE=service_new_db
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# Autenticação JWT
JWT_SECRET=your_jwt_secret_here

# Configurações do Swagger e SSL
ACTIVATE_SWAGGER=YES
ACTIVATE_SSL_CERTIFICATE=NOT
SSL_KEY=/etc/letsencrypt/live/domain_here/privkey.pem
SSL_CERT=/etc/letsencrypt/live/domain_here/fullchain.pem
SSL_CA=/etc/letsencrypt/live/domain_here/chain.pem

# Credenciais AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_FORCE_PATH_STYLE=true

# Envio de E-mails
MAIL_FROM=no-reply@example.com
MAIL_MESSAGE_CONTACTUS=Caixa para receber emails de fale conosco
MAIL_SECURE=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_smtp_user@smtp-brevo.com
MAIL_PASSWORD=your_mail_password

# Webhook / NGROK Integration
URL_INTEGRATION=https://your-ngrok-url.ngrok-free.app

# NGROK (Opcional)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_REGION=sa

# Twilio (Envio de SMS e WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXyour_approved_content_template_sid

# Mercado Pago (Checkout Pro & Split Automático OAuth)
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret
MERCADOPAGO_CLIENT_ID=your_mercadopago_client_id
MERCADOPAGO_CLIENT_SECRET=your_mercadopago_client_secret
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/mercado-pago/callback

