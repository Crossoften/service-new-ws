# Server
HOST=http://localhost
PORT=8000

# NGROK
ENABLE_NGROK=false
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# NGROK_DOMAIN=your-ngrok-domain.ngrok-free.app
NGROK_REGION=sa

# Configurações para rodar o projeto com Docker Compose 🐳

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
# Importânte definir e que seja o mesmo nome de <db_name> caso esteja rodando local.
# Projetos que utilizam SQL manual, usam essa variável para chamar o banco de dados.
DB_DATABASE=service_new_db

FRONTEND_URL=""

# Caso esteja rodando local, linha abaixo deve ser comentada. 🚨
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# Configurações para rodar o projeto localmente, sem Docker Compose 📍

# Caso esteja rodando via Docker Compose, linha abaixo deve estar comentada. 🚨
# DATABASE_URL=mysql://<user>:<password>@<host>:<db_port>/<db_name>

# Segredo e tempo de duração dos tokens gerados.
JWT_SECRET=your_jwt_secret_here

# Ativa/Desativa Swagger.
ACTIVATE_SWAGGER='YES'

# Ativa/Desativa SSL.
ACTIVATE_SSL_CERTIFICATE=NOT
SSL_KEY=/etc/letsencrypt/live/domain_here/privkey.pem
SSL_CERT=/etc/letsencrypt/live/domain_here/fullchain.pem
SSL_CA=/etc/letsencrypt/live/domain_here/chain.pem

# Credenciais da AWS.
# AWS_ACCESS_KEY_ID=minio_dev_admin
# AWS_SECRET_ACCESS_KEY=minio_dev_password_super_secreto_123
# AWS_REGION=us-east-1
# AWS_ENDPOINT=http://184.174.32.25:9000/
# AWS_S3_BUCKET=dev-uploads
# AWS_S3_FORCE_PATH_STYLE=true


# Credenciais da S3 (MINIO CONSOLE).
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# AWS_ENDPOINT=http://localhost:9000
# AWS_S3_BUCKET=dev-upload
# AWS_S3_FORCE_PATH_STYLE=true

# Credenciais da S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# AWS_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_FORCE_PATH_STYLE=true


# Credenciais SendGrid para envio de emails.
# MAIL_SECURE e MAIL_PORT estão relacionados!
# Se MAIL_PORT=465 então MAIL_SECURE=true 🚨
# Se MAIL_PORT=587 então MAIL_SECURE=false 🚨
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=<465> | <587>
# MAIL_SECURE=true
# MAIL_USER=apikey
# MAIL_PASSWORD=your_password

# MAIL_FROM=no-reply@example.com
# MAIL_MESSAGE_CONTACTUS=Caixa para receber emails de fale conosco.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_SECURE=false

MAIL_FROM=no-reply@example.com
MAIL_MESSAGE_CONTACTUS=Caixa para receber emails de fale conosco.
MAIL_SECURE=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_smtp_user@smtp-brevo.com
MAIL_PASSWORD=your_mail_password
# SMTP_FROM=no-reply@example.com
# SMTP_TO=contact@example.com

# Utilizada em testes de integrações, debugs, interações com Webhooks entre outras coisas.
URL_INTEGRATION=https://your-ngrok-url.ngrok-free.app

# Credenciais do Twilio para envio de SMS (recuperação de senha via SMS).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Credenciais do Mercado Pago (Checkout Pro). Sem MERCADOPAGO_ACCESS_TOKEN, os
# endpoints de pagamento respondem 503 em vez de falhar com erro 500.
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# Credenciais da API oficial do WhatsApp (Meta Cloud API) para notificações automáticas.
# Sem essas variáveis, as notificações são apenas logadas e ignoradas silenciosamente.
# WHATSAPP_TEMPLATE_NAME precisa ser um template de utilidade aprovado no Meta Business Manager,
# com um único parâmetro de corpo ({{1}}) — é nele que o texto da notificação é injetado.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=notificacao_service_app
WHATSAPP_TEMPLATE_LANGUAGE_CODE=pt_BR
