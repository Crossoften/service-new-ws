#############################################
# service-new-ws — variáveis de ambiente
#
# Copie para .env e preencha os valores.
#   cp .env.example .env
#
# Legenda do comportamento quando a variável falta:
#   [BOOT]     a aplicação NÃO sobe
#   [RUNTIME]  a aplicação sobe; só a feature correspondente falha
#   [DEGRADA]  a aplicação sobe e a feature é ignorada sem erro
#############################################


#############################################
# 1. OBRIGATÓRIAS — sem estas a API não sobe
#############################################

# [BOOT] Porta HTTP. Não há valor padrão no código.
PORT=8000

# [BOOT] Segredo de assinatura dos JWT.
# Use um valor longo e aleatório. NUNCA reaproveite o segredo de produção
# em ambiente local — trocar este valor invalida todos os tokens emitidos.
#   openssl rand -hex 32
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# [BOOT] Conexão com o MySQL, no formato do Prisma.
# Local (padrão):
DATABASE_URL=mysql://root:root@127.0.0.1:3306/service_new_db
# Dentro do docker-compose, o host do banco é o nome do serviço (db):
# DATABASE_URL=mysql://root:sua_senha@db:3306/service_new_db

# [BOOT] O MailService faz .includes() nesta variável no construtor:
# se ficar vazia, a aplicação não sobe.
# Regra: MAIL_PORT=465 -> true | MAIL_PORT=587 -> false
MAIL_SECURE=false


#############################################
# 2. BANCO — usadas pelo docker-compose
#
# O código da aplicação lê apenas DATABASE_URL. As variáveis abaixo
# alimentam o serviço `db` do docker-compose e servem para montar a
# DATABASE_URL por interpolação, se você preferir.
#############################################

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=service_new_db


#############################################
# 3. SERVIDOR
#############################################

# Compõe o "server" exibido no Swagger. Não afeta o bind da aplicação.
HOST=http://localhost

# Publica a documentação em /docs quando igual a YES.
ACTIVATE_SWAGGER=YES

# TLS terminado pela própria aplicação. Em deploy atrás de proxy
# (nginx, Traefik, ALB), mantenha NOT e termine o TLS no proxy.
# ATENÇÃO: hoje helmet() e compression() só são aplicados quando isto
# é YES — atrás de proxy a API roda sem headers de segurança.
ACTIVATE_SSL_CERTIFICATE=NOT
SSL_KEY=/etc/letsencrypt/live/seu_dominio/privkey.pem
SSL_CERT=/etc/letsencrypt/live/seu_dominio/fullchain.pem
SSL_CA=/etc/letsencrypt/live/seu_dominio/chain.pem

# URL pública desta API. É para onde o Mercado Pago envia as notificações
# de pagamento (notification_url do Checkout Pro) e também aparece no Swagger.
# Em desenvolvimento, use o endereço público de um túnel (ngrok, cloudflared).
URL_INTEGRATION=https://seu-tunel.ngrok-free.app

# URL do frontend. Usada para montar as back_urls do Checkout Pro
# (retorno do usuário após pagar) e, na ausência de CORS_ORIGINS, como
# única origem autorizada no CORS.
FRONTEND_URL=http://localhost:4200

# Origens autorizadas no CORS, separadas por vírgula. Tem precedência sobre
# FRONTEND_URL — use quando mais de um domínio precisar consumir a API
# (ex.: app web + portal administrativo).
# Se ficar vazia E FRONTEND_URL também, a API libera qualquer origem.
# CORS_ORIGINS=http://localhost:4200,https://app.exemplo.com.br


#############################################
# 4. ARMAZENAMENTO — AWS S3
# [RUNTIME] Sem estas, apenas as rotas de upload/download falham.
#############################################

AWS_ACCESS_KEY_ID=sua_access_key_id
AWS_SECRET_ACCESS_KEY=sua_secret_access_key
AWS_REGION=us-east-1

# ATENÇÃO ao nome: o código lê AWS_BUCKET_NAME.
# (Versões anteriores deste arquivo declaravam AWS_S3_BUCKET, que nunca é lido.)
AWS_BUCKET_NAME=nome-do-seu-bucket


#############################################
# 5. SMS — Twilio
# [DEGRADA] Sem estas, o SmsService fica desabilitado: o envio de SMS
# responde erro tratado e o restante da API funciona normalmente.
# O SID precisa começar com "AC" para ser aceito pelo SDK.
#############################################

TWILIO_ACCOUNT_SID=seu_twilio_account_sid
TWILIO_AUTH_TOKEN=seu_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000


#############################################
# 6. E-MAIL — SMTP
# [RUNTIME] Sem estas, o envio de e-mail falha quando acionado
# (recuperação de senha e fale conosco).
#############################################

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=seu_usuario_smtp
MAIL_PASSWORD=sua_senha_smtp
MAIL_FROM=no-reply@example.com

# Caixa que recebe as mensagens do "fale conosco".
# ATENÇÃO ao nome: o código lê MAIL_CONTACTUS.
# (Versões anteriores deste arquivo declaravam MAIL_MESSAGE_CONTACTUS,
#  que nunca é lido — as mensagens ficavam sem destinatário.)
MAIL_CONTACTUS=contato@example.com


#############################################
# 7. PAGAMENTO — Mercado Pago (Checkout Pro)
# [DEGRADA] Sem o access token, os endpoints de pagamento
# respondem 503 em vez de estourar erro 500.
#############################################

MERCADOPAGO_ACCESS_TOKEN=seu_access_token_do_mercado_pago

# Segredo da assinatura do webhook, obtido no painel do Mercado Pago.
# Quando vazio, a verificação de assinatura é ignorada — configure em
# qualquer ambiente exposto à internet.
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret


#############################################
# 8. NOTIFICAÇÕES — WhatsApp Cloud API (Meta)
# [DEGRADA] Sem estas, as notificações são apenas logadas e ignoradas.
#
# WHATSAPP_TEMPLATE_NAME precisa ser um template de utilidade aprovado no
# Meta Business Manager, com um único parâmetro de corpo ({{1}}) — é nele
# que o texto da notificação é injetado.
#############################################

WHATSAPP_ACCESS_TOKEN=seu_token_da_cloud_api
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=notificacao_service_app
WHATSAPP_TEMPLATE_LANGUAGE_CODE=pt_BR


#############################################
# 9. SEEDS
#############################################

# Base pública das imagens de categoria de serviço, usada por
# prisma/seeds/service-category.seeds.ts. Se vazia, o seed roda
# e as categorias ficam sem imagem.
SERVICE_CATEGORY_PUBLIC_URL_BASE=


#############################################
# Nota sobre ngrok
#
# ENABLE_NGROK, NGROK_AUTHTOKEN e NGROK_REGION constavam neste arquivo,
# mas NÃO são lidas por nenhum ponto do código. O túnel é iniciado por
# fora (CLI do ngrok ou cloudflared); o que a aplicação consome é o
# endereço público resultante, informado em URL_INTEGRATION (seção 3).
#############################################
