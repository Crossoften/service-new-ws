/// Como o valor da faixa é interpretado.
enum DeliveryFeeTypeEnum {
  /// Valor em reais, cobrado integralmente.
  Fixed
  /// Percentual sobre o valor dos itens do pedido, sem contar a própria taxa.
  Percent
}

/// Faixa de distância que determina a taxa de entrega.
///
/// Configurada pelo admin. O servidor mede a distância entre o endereço do
/// restaurante e o do cliente e escolhe a faixa correspondente — o cliente não
/// tem voz nisso. Antes, `deliveryFee` vinha no corpo do pedido, e como o
/// entregador recebe 100% dessa taxa, quem pagava definia quanto o entregador
/// ganhava.
model DeliveryFeeRule {
  id Int @id @default(autoincrement())

  /// Início da faixa, em quilômetros, inclusivo.
  minKm    Decimal             @db.Decimal(6, 2)
  /// Fim da faixa, exclusivo. Nulo significa "daqui em diante".
  maxKm    Decimal?            @db.Decimal(6, 2)
  type     DeliveryFeeTypeEnum @default(Fixed)
  /// Reais quando Fixed, percentual quando Percent.
  value    Decimal             @db.Decimal(10, 2)
  isActive Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, minKm])
  @@map("delivery_fee_rules")
}

