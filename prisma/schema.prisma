model Restaurant {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  description String? @db.LongText()
  imageUrl    String? @db.VarChar(1500)
  imageKey    String? @db.VarChar(1500)
  isActive    Boolean @default(true)
  isOpen      Boolean @default(true)
  categoryId  Int
  userId      Int     @unique
  addressId   Int?    @unique

  /// Faixa de tempo estimado de entrega, em minutos, exibida na vitrine.
  /// Dois campos em vez de um porque a tela mostra intervalo ("30-45 min");
  /// preenchendo os dois com o mesmo valor, vira número único.
  deliveryTimeMinMinutes Int?
  deliveryTimeMaxMinutes Int?

  /// O estabelecimento cobra cartão na própria maquininha, na entrega.
  ///
  /// Quando ligado, pedido no cartão não gera checkout nem split: o dinheiro
  /// não passa pela plataforma em momento nenhum. A consequência é que o frete
  /// e a gorjeta também não são retidos, e **o repasse ao entregador passa a
  /// ser responsabilidade do estabelecimento** — é justamente essa
  /// responsabilidade que o aceite registra.
  ///
  /// Pix e boleto continuam pelo gateway: a maquininha é de cartão.
  usesOwnCardMachine Boolean @default(false)

  /// Quando o aceite de responsabilidade foi dado, por quem, e sobre qual
  /// texto. Os três nascem juntos ao ligar a modalidade e são limpos ao
  /// desligar — religar exige aceitar de novo, porque o termo pode ter mudado.
  cardMachineAcceptedAt   DateTime?
  cardMachineAcceptedById Int?
  cardMachineTermsVersion String?   @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       RestaurantCategory @relation(fields: [categoryId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  cardMachineAcceptedBy User?       @relation("RestaurantCardMachineAcceptance", fields: [cardMachineAcceptedById], references: [id])
  address        Address?           @relation(fields: [addressId], references: [id])
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  foodOrders     FoodOrder[]
  reviews        Review[]
  coupons        Coupon[]


  @@index([categoryId])
  @@map("restaurants")
}

