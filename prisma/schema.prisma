generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name           String
  // Opcional por decisão de produto (25/08/2026): a identidade principal do
  // usuário passou a ser o telefone, verificado por SMS. MySQL aceita vários
  // NULL num índice único, então a unicidade continua valendo para quem informa.
  email          String?          @unique
  document       String?          @unique @db.VarChar(18)
  biography      String?          @db.LongText()
  phone          String?          @unique
  password       String
  code           String?          @db.VarChar(72)
  codeExpiresIn  DateTime?
  // Verificação de conta. Colunas próprias de propósito: `code` acima pertence
  // à recuperação de senha, e compartilhar o campo faria um fluxo invalidar o
  // outro — quem pedisse "esqueci a senha" perderia o código de verificação.
  verificationCode      String?   @db.VarChar(72)
  verificationExpiresIn DateTime?
  role           Role             @default(User)
  profileType    UserProfileType  @default(Client)
  status         Status           @default(Pending)
  fileUrl        String?          @db.VarChar(1500)
  fileKey        String?          @db.VarChar(1500)
  referralCode   String?          @unique @db.VarChar(80)
  birthDate      DateTime?

  /// Comissão do INFLUENCIADOR sobre as indicações dele, em percentual.
  /// Escrita pelo admin em `/v1/admin/influencers/:id/commission` e lida em
  /// `referrals.service`. Nula usa a taxa global de `PlatformSettings`.
  ///
  /// Até 21/09/2026 este campo era lido também pelo delivery, para calcular a
  /// comissão do restaurante — dois domínios sem relação disputando a mesma
  /// coluna. Um usuário que fosse influenciador e dono de restaurante tinha a
  /// taxa de indicação aplicada sobre os pedidos dele, em silêncio.
  commissionRate Decimal?         @db.Decimal(5, 2)

  /// Comissão do DELIVERY sobre os itens de cada pedido, em percentual.
  /// Vale só para quem opera no modelo de comissão (`billingType`
  /// `Commission`). Nula usa o padrão de 20% de `food-orders/commission.ts`.
  deliveryCommissionRate Decimal?  @db.Decimal(5, 2)

  billingType    BillingTypeEnum?

  // Vínculo da conta do vendedor no Mercado Pago, para o split automático.
  // `mpUserId` e `mpPublicKey` são identificadores públicos e ficam em claro.
  // Os dois tokens são CIFRADOS antes de gravar (ver src/utils/secretBox.ts):
  // eles autorizam movimentar dinheiro em nome do vendedor, então um vazamento
  // de banco em texto puro daria acesso às contas dos prestadores.
  // O texto cifrado é maior que o original, daí o VarChar(500).
  mpUserId       String?          @db.VarChar(120)
  mpAccessToken  String?          @db.VarChar(500)
  mpRefreshToken String?          @db.VarChar(500)
  mpPublicKey    String?          @db.VarChar(255)
  mpLinkedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPermissions           AdminPermission[]
  accommodations             Accommodation[]
  bankAccount                BankAccount?
  files                      File[]
  products                   Product[]
  transportations            Transportation[]
  services                   Service[]
  reviews                    Review[]
  requestedBudgets           Budget[]                @relation("BudgetRequester")
  providedBudgets            Budget[]                @relation("BudgetProvider")
  requestedWorks             Work[]                  @relation("WorkRequester")
  sentPayments               Payment[]               @relation("PaymentPayer")
  financialTransactions      FinancialTransaction[]
  providedWorks              Work[]                  @relation("WorkProvider")
  receivedPayments           Payment[]               @relation("PaymentReceiver")
  purchases                  CommercialTransaction[] @relation("CommercialTransactionBuyer")
  sales                      CommercialTransaction[] @relation("CommercialTransactionSeller")
  subscriptions              Subscription[]
  grantedSubscriptions       Subscription[]          @relation("SubscriptionGrantedBy")
  chatParticipants           ChatParticipant[]
  chatMessages               ChatMessage[]           @relation("ChatMessageSender")
  createdChatRooms           ChatRoom[]              @relation("ChatRoomCreator")
  referrals                  Referral[]              @relation("InfluencerReferrals")
  referredByInfluencer       Referral?               @relation("ReferredByInfluencer")
  socialMedias               UserSocialMedia[]
  restaurant                 Restaurant?
  foodOrders                 FoodOrder[]             @relation("FoodOrderCustomer")
  confirmedFoodOrderPayments FoodOrder[]             @relation("FoodOrderPaymentConfirmer")
  courierAssignments         DeliveryAssignment[]    @relation("DeliveryAssignmentCourier")
  rentalsRequested           Rental[]                @relation("RentalRequester")
  rentalsProvided            Rental[]                @relation("RentalProvider")
  transportRequestsRequested TransportRequest[]      @relation("TransportRequestRequester")
  transportRequestsProvided  TransportRequest[]      @relation("TransportRequestProvider")
  bookingsRequested          Booking[]               @relation("BookingRequester")
  bookingsProvided           Booking[]               @relation("BookingProvider")
  jobs                       Job[]                   @relation("JobEmployer")
  jobApplications            JobApplication[]        @relation("JobApplicant")
  addressId                  Int?                    @unique
  address                    Address?                @relation(fields: [addressId], references: [id])
  couponsCreated   Coupon[]           @relation("CouponCreator")
  couponRedemptions CouponRedemption[] @relation("CouponRedeemer")
  pushSubscriptions PushSubscription[] @relation("UserPushSubscriptions")
  deliveryPayouts        DeliveryPayout[] @relation("DeliveryPayoutCourier")
  deliveryPayoutsCreated DeliveryPayout[] @relation("DeliveryPayoutCreator")
  cardMachineAcceptances Restaurant[]     @relation("RestaurantCardMachineAcceptance")



  @@map("users")
}

model UserSocialMedia {
  id        Int               @id @default(autoincrement())
  userId    Int
  network   SocialNetworkEnum
  url       String            @db.VarChar(500)
  followers Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
  @@index([userId])
  @@map("user_social_medias")
}

model PlatformSettings {
  id                       Int     @id @default(1)
  influencerCommissionRate Decimal @default(0) @db.Decimal(5, 2)
  // Percentual retido pela plataforma no split do Mercado Pago. Global, usado
  // quando a categoria do serviço não define taxa própria. Configurável em vez
  // de fixo no código: a taxa é decisão comercial e muda sem deploy.
  marketplaceFeeRate       Decimal @default(10) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AdminPermission {
  id Int @id @default(autoincrement())

  name AdminPermissions @unique()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User[]

  @@map("admin_permissions")
}

model ServiceCategory {
  id              Int     @id @default(autoincrement())
  platformFeeRate Decimal @default(0) @db.Decimal(5, 2)
  name            String  @unique @db.VarChar(120)
  slug            String  @unique @db.VarChar(120)
  iconUrl         String? @db.VarChar(1500)
  iconKey         String? @db.VarChar(1500)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  plans     Plan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

model TransportationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportations Transportation[]

  @@map("transportation_categories")
}

model AccommodationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodations Accommodation[]

  @@map("accommodation_categories")
}

model Product {
  id Int @id @default(autoincrement())

  name            String                     @db.VarChar(160)
  transactionType ProductTransactionTypeEnum @default(Sale)
  model           String?                    @db.VarChar(160)
  year            Int?
  price           Decimal                    @db.Decimal(10, 2)
  description     String?                    @db.LongText()
  imageUrl        String?                    @db.VarChar(1500)
  imageKey        String?                    @db.VarChar(1500)
  isActive        Boolean                    @default(true)
  categoryId      Int
  userId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category               ProductCategory         @relation(fields: [categoryId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  reviews                Review[]
  commercialTransactions CommercialTransaction[]
  rentals                Rental[]

  @@index([categoryId])
  @@index([userId])
  @@map("products")
}

model Transportation {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  model       String? @db.VarChar(160)
  mileageKm   Int?
  capacity    Int?
  year        Int?
  price       Decimal @db.Decimal(10, 2)
  description String? @db.LongText()
  imageUrl    String? @db.VarChar(1500)
  imageKey    String? @db.VarChar(1500)
  isActive    Boolean @default(true)
  categoryId  Int
  userId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          TransportationCategory @relation(fields: [categoryId], references: [id])
  user              User                   @relation(fields: [userId], references: [id])
  reviews           Review[]
  transportRequests TransportRequest[]

  @@index([categoryId])
  @@index([userId])
  @@map("transportations")
}

model Accommodation {
  id Int @id @default(autoincrement())

  name          String  @db.VarChar(160)
  addressId     Int?    @unique
  roomsQuantity Int?
  price         Decimal @db.Decimal(10, 2)
  description   String? @db.LongText()
  imageUrl      String? @db.VarChar(1500)
  imageKey      String? @db.VarChar(1500)
  isActive      Boolean @default(true)
  categoryId    Int
  userId        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address        Address?                    @relation(fields: [addressId], references: [id])
  category       AccommodationCategory       @relation(fields: [categoryId], references: [id])
  user           User                        @relation(fields: [userId], references: [id])
  reviews        Review[]
  bookings       Booking[]
  availabilities AccommodationAvailability[]

  @@index([addressId])
  @@index([categoryId])
  @@index([userId])
  @@map("accommodations")
}

model Address {
  id Int @id @default(autoincrement())

  street       String? @db.VarChar(160)
  neighborhood String? @db.VarChar(120)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(120)
  zipCode      String? @db.VarChar(20)
  number       String? @db.VarChar(20)

  // Coordenadas para o cálculo do frete por distância. Mesma precisão já usada
  // em DeliveryAssignment. Opcionais: os endereços cadastrados antes disto não
  // têm, e quem preenche é o front, ao geocodificar o endereço escolhido.
  // Sem elas o pedido cai na taxa padrão (ver DeliveryFeeRule).
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation?
  subscriptions Subscription[]
  user          User?
  restaurant    Restaurant?
  foodOrders    FoodOrder[]

  @@map("addresses")
}

/// Tipo da chave Pix. Define como a chave é normalizada e validada.
enum PixKeyTypeEnum {
  Cpf
  Cnpj
  Email
  Phone
  /// Chave aleatória (EVP), o UUID que o banco gera.
  Random
}

model BankAccount {
  id Int @id @default(autoincrement())

  bankName    String              @db.VarChar(120)
  accountType BankAccountTypeEnum
  agency      String              @db.VarChar(30)
  account     String              @db.VarChar(30)
  cpf         String              @db.VarChar(14)

  /// Chave Pix, gravada já normalizada: CPF e CNPJ só com dígitos, telefone em
  /// E.164, e-mail em minúsculas. É por ela que o repasse ao entregador é pago;
  /// agência e conta ficam como alternativa para TED.
  ///
  /// Opcional porque a conta bancária existe desde antes do Pix no projeto, e
  /// exigir a chave agora invalidaria todos os cadastros já feitos. Os dois
  /// campos andam juntos: ou ambos preenchidos, ou ambos nulos.
  pixKey      String?             @db.VarChar(191)
  pixKeyType  PixKeyTypeEnum?

  userId      Int                 @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("bank_accounts")
}

model Service {
  id Int @id @default(autoincrement())

  name             String          @db.VarChar(160)
  type             ServiceTypeEnum
  registrationCode String?         @db.VarChar(80)

  /// Preço de referência, **opcional**.
  ///
  /// Decisão da reunião de 21/09: o serviço não precisa ter valor fixo no
  /// cadastro. O preço que vale é o que o profissional informa ao responder a
  /// solicitação (`Budget.responseValue`), e é dele que o trabalho e o
  /// pagamento tiram o valor. Este campo vira vitrine — "a partir de R$ X" —
  /// ou fica nulo quando tudo é sob orçamento.
  price            Decimal?        @db.Decimal(10, 2)
  description      String?         @db.LongText()
  imageUrl         String?         @db.VarChar(1500)
  imageKey         String?         @db.VarChar(1500)
  isActive         Boolean         @default(true)
  categoryId       Int
  userId           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  budgets  Budget[]
  works    Work[]
  reviews  Review[]

  @@index([categoryId])
  @@index([userId])
  @@map("services")
}

model Review {
  id Int @id @default(autoincrement())

  type             ReviewTypeEnum
  // Nota de 1 a 5. Opcional no modelo porque as avaliações de serviço, produto,
  // hospedagem e transporte nunca tiveram nota — só `type` e comentário. A rota
  // de restaurante exige; as demais seguem como estavam.
  rating           Int?           @db.SmallInt
  comment          String?        @db.LongText()
  serviceId        Int?
  productId        Int?
  accommodationId  Int?
  transportationId Int?
  requesterId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service        Service?        @relation(fields: [serviceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  accommodation  Accommodation?  @relation(fields: [accommodationId], references: [id])
  transportation Transportation? @relation(fields: [transportationId], references: [id])
  requester      User            @relation(fields: [requesterId], references: [id])
  Restaurant     Restaurant?     @relation(fields: [restaurantId], references: [id])
  restaurantId   Int?

  @@unique([serviceId, requesterId])
  @@unique([productId, requesterId])
  @@unique([accommodationId, requesterId])
  @@unique([transportationId, requesterId])
  // Faltava: os outros quatro tipos já tinham a trava, restaurante ficou de
  // fora. Sem ela, o mesmo cliente avalia o mesmo restaurante quantas vezes
  // quiser e a média vira função de insistência.
  @@unique([restaurantId, requesterId])
  @@index([serviceId])
  @@index([productId])
  @@index([accommodationId])
  @@index([transportationId])
  @@index([requesterId])
  @@index([restaurantId])
  @@index([type])
  @@map("reviews")
}

model Budget {
  id Int @id @default(autoincrement())

  description             String?             @db.LongText()
  status                  BudgetStatusEnum    @default(Pending)
  responseDescription     String?             @db.LongText()
  responseValue           Decimal?            @db.Decimal(10, 2)
  extraRequestValue       Decimal?            @db.Decimal(10, 2)
  extraRequestDescription String?             @db.LongText()
  extraRequestStatus      ExtraRequestStatus?
  extraRequestedAt        DateTime?
  extraRespondedAt        DateTime?
  responseTimeQuantity    Int?
  responseTimeUnit        BudgetTimeUnitEnum?

  /// Quando o cliente decidiu, e por quê no caso da recusa.
  ///
  /// `Accepted` e `Rejected` são terminais: depois de qualquer um dos dois o
  /// orçamento não aceita mais alteração. O motivo da recusa é opcional e serve
  /// ao prestador — sem ele, a recusa chega como um "não" sem contexto.
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectReason            String?             @db.LongText()

  serviceId               Int?
  requesterId             Int
  providerId              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service             Service?            @relation(fields: [serviceId], references: [id])
  requester           User                @relation("BudgetRequester", fields: [requesterId], references: [id])
  provider            User                @relation("BudgetProvider", fields: [providerId], references: [id])
  files               BudgetFile[]
  informationRequests BudgetInformation[]
  work                Work?

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("budgets")
}

model BudgetFile {
  id Int @id @default(autoincrement())

  fileName             String             @db.VarChar(191)
  fileUrl              String             @db.VarChar(1500)
  fileKey              String             @db.VarChar(1500)
  type                 BudgetFileTypeEnum @default(Request)
  budgetId             Int
  informationRequestId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget             Budget             @relation(fields: [budgetId], references: [id])
  informationRequest BudgetInformation? @relation(fields: [informationRequestId], references: [id])

  @@index([budgetId])
  @@index([informationRequestId])
  @@map("budget_files")
}

model BudgetInformation {
  id Int @id @default(autoincrement())

  message  String @db.LongText()
  budgetId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget       @relation(fields: [budgetId], references: [id])
  files  BudgetFile[]

  @@index([budgetId])
  @@map("budget_information")
}

model Work {
  id Int @id @default(autoincrement())

  status                      WorkStatusEnum         @default(Pending)
  details                     String?                @db.LongText()
  completionDescription       String?                @db.LongText()
  cancelReason                String?                @db.LongText()
  serviceDate                 DateTime?
  startedAt                   DateTime?
  arrivalConfirmedAt          DateTime?
  finishedAt                  DateTime?
  cancelledAt                 DateTime?
  warrantyExpiresAt           DateTime?
  warrantyRequestedAt         DateTime?
  warrantyRequestDescription  String?                @db.LongText()
  warrantyRequestStatus       WarrantyRequestStatus?
  warrantyResponseDescription String?                @db.LongText()
  warrantyRespondedAt         DateTime?
  extraRequestValue           Decimal?               @db.Decimal(10, 2)
  extraRequestDescription     String?                @db.LongText()
  extraRequestStatus          ExtraRequestStatus?
  extraRequestedAt            DateTime?
  extraRespondedAt            DateTime?
  serviceValue                Decimal?               @db.Decimal(10, 2)
  totalValue                  Decimal?               @db.Decimal(10, 2)

  /// Trabalho original, quando este é um reparo em garantia.
  ///
  /// Preenchido ⇒ é reparo. Nasce em `respondWarranty(Approved)`, com ciclo
  /// próprio: o fornecedor roda `start` → `finish` como em qualquer trabalho.
  /// Reabrir o trabalho original seria mais barato de escrever e pior de
  /// operar — o histórico do atendimento original ficaria sobrescrito, e o
  /// cliente perderia a distinção entre o serviço e o conserto dele.
  parentWorkId                Int?

  /// Redundante com `parentWorkId != null`, e existe assim de propósito: o
  /// front badgea "Garantia" e as travas de cobrança filtram por este campo
  /// sem precisar carregar a relação.
  isWarranty                  Boolean                @default(false)

  /// Opcional desde a execução da garantia: o reparo não nasce de orçamento.
  /// Em MySQL o índice único aceita vários NULL, então a unicidade continua
  /// valendo para quem tem orçamento.
  budgetId                    Int?                   @unique

  serviceId                   Int
  requesterId                 Int
  providerId                  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget        Budget?    @relation(fields: [budgetId], references: [id])
  parentWork    Work?      @relation("WorkWarranty", fields: [parentWorkId], references: [id])
  warrantyWorks Work[]     @relation("WorkWarranty")
  service       Service    @relation(fields: [serviceId], references: [id])
  requester     User       @relation("WorkRequester", fields: [requesterId], references: [id])
  provider      User       @relation("WorkProvider", fields: [providerId], references: [id])
  files         WorkFile[]

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@index([parentWorkId])
  @@index([providerId, isWarranty, status])
  @@map("works")
}

model ChatRoom {
  id            Int             @id @default(autoincrement())
  contextType   ChatContextType
  referenceId   Int
  createdById   Int?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User?             @relation("ChatRoomCreator", fields: [createdById], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@unique([contextType, referenceId])
  @@index([createdById])
  @@index([contextType, referenceId])
  @@index([lastMessageAt])
  @@map("chat_rooms")
}

model ChatParticipant {
  id         Int       @id @default(autoincrement())
  roomId     Int
  userId     Int
  lastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id       Int     @id @default(autoincrement())
  roomId   Int
  senderId Int
  message  String? @db.LongText()
  fileName String? @db.VarChar(191)
  fileUrl  String? @db.VarChar(1500)
  fileKey  String? @db.VarChar(1500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
  @@map("chat_messages")
}

model CommercialTransaction {
  id Int @id @default(autoincrement())

  referenceType   CommercialTransactionReferenceTypeEnum
  referenceId     Int
  status          CommercialTransactionStatusEnum        @default(Requested)
  title           String?                                @db.VarChar(191)
  description     String?                                @db.LongText()
  requestedAmount Decimal                                @db.Decimal(10, 2)
  agreedAmount    Decimal?                               @db.Decimal(10, 2)
  buyerId         Int
  sellerId        Int
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  paidAt          DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer   User    @relation("CommercialTransactionBuyer", fields: [buyerId], references: [id])
  seller  User    @relation("CommercialTransactionSeller", fields: [sellerId], references: [id])
  product Product @relation(fields: [referenceId], references: [id])

  @@index([referenceType, referenceId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("commercial_transactions")
}

model Payment {
  id Int @id @default(autoincrement())

  method            PaymentMethodEnum?
  status            PaymentStatusEnum        @default(Pending)
  referenceType     PaymentReferenceTypeEnum
  referenceId       Int
  holderName        String?                  @db.VarChar(160)
  cardBrand         String?                  @db.VarChar(60)
  cardLast4         String?                  @db.VarChar(4)
  amount            Decimal                  @db.Decimal(10, 2)
  paidAt            DateTime?
  payerId           Int
  receiverId        Int
  externalReference String?                  @unique @db.VarChar(64)
  mpPreferenceId    String?                  @db.VarChar(120)
  mpPaymentId       String?                  @unique @db.VarChar(120)

  /// Valor retido pela plataforma no split, gravado na geração do checkout.
  /// É o único momento em que ele é conhecido: o Mercado Pago desconta na
  /// origem e o recebedor nunca vê esse dinheiro entrar.
  platformFeeAmount Decimal?                 @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payer        User                   @relation("PaymentPayer", fields: [payerId], references: [id])
  receiver     User                   @relation("PaymentReceiver", fields: [receiverId], references: [id])
  transactions FinancialTransaction[]

  @@index([payerId])
  @@index([receiverId])
  @@index([referenceType, referenceId])
  @@index([status])
  @@map("payments")
}

