generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name           String
  email          String           @unique
  document       String?          @unique @db.VarChar(18)
  biography      String?          @db.LongText()
  phone          String?          @unique
  password       String
  code           String?          @db.VarChar(4)
  codeExpiresIn  DateTime?
  role           Role             @default(User)
  profileType    UserProfileType  @default(Client)
  status         Status           @default(Pending)
  fileUrl        String?          @db.VarChar(1500)
  fileKey        String?          @db.VarChar(1500)
  referralCode   String?          @unique @db.VarChar(80)
  birthDate      DateTime?
  commissionRate Decimal?         @db.Decimal(5, 2)
  billingType    BillingTypeEnum?

  mpUserId       String?          @db.VarChar(120)
  mpAccessToken  String?          @db.VarChar(500)
  mpRefreshToken String?          @db.VarChar(500)
  mpPublicKey    String?          @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPermissions           AdminPermission[]
  accommodations             Accommodation[]
  bankAccount                BankAccount?
  files                      File[]
  products                   Product[]
  transportations            Transportation[]
  services                   Service[]
  reviews                    Review[]
  requestedBudgets           Budget[]                @relation("BudgetRequester")
  providedBudgets            Budget[]                @relation("BudgetProvider")
  requestedWorks             Work[]                  @relation("WorkRequester")
  sentPayments               Payment[]               @relation("PaymentPayer")
  financialTransactions      FinancialTransaction[]
  providedWorks              Work[]                  @relation("WorkProvider")
  receivedPayments           Payment[]               @relation("PaymentReceiver")
  purchases                  CommercialTransaction[] @relation("CommercialTransactionBuyer")
  sales                      CommercialTransaction[] @relation("CommercialTransactionSeller")
  subscriptions              Subscription[]
  chatParticipants           ChatParticipant[]
  chatMessages               ChatMessage[]           @relation("ChatMessageSender")
  createdChatRooms           ChatRoom[]              @relation("ChatRoomCreator")
  referrals                  Referral[]              @relation("InfluencerReferrals")
  referredByInfluencer       Referral?               @relation("ReferredByInfluencer")
  socialMedias               UserSocialMedia[]
  restaurant                 Restaurant?
  foodOrders                 FoodOrder[]             @relation("FoodOrderCustomer")
  courierAssignments         DeliveryAssignment[]    @relation("DeliveryAssignmentCourier")
  rentalsRequested           Rental[]                @relation("RentalRequester")
  rentalsProvided            Rental[]                @relation("RentalProvider")
  transportRequestsRequested TransportRequest[]      @relation("TransportRequestRequester")
  transportRequestsProvided  TransportRequest[]      @relation("TransportRequestProvider")
  bookingsRequested          Booking[]               @relation("BookingRequester")
  bookingsProvided           Booking[]               @relation("BookingProvider")
  jobs                       Job[]                   @relation("JobEmployer")
  jobApplications            JobApplication[]        @relation("JobApplicant")
  addressId                  Int?                    @unique
  address                    Address?                @relation(fields: [addressId], references: [id])

  @@map("users")
}

model UserSocialMedia {
  id        Int               @id @default(autoincrement())
  userId    Int
  network   SocialNetworkEnum
  url       String            @db.VarChar(500)
  followers Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
  @@index([userId])
  @@map("user_social_medias")
}

model PlatformSettings {
  id                       Int     @id @default(1)
  influencerCommissionRate Decimal @default(0) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AdminPermission {
  id Int @id @default(autoincrement())

  name AdminPermissions @unique()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User[]

  @@map("admin_permissions")
}

model ServiceCategory {
  id              Int     @id @default(autoincrement())
  platformFeeRate Decimal @default(0) @db.Decimal(5, 2)
  name            String  @unique @db.VarChar(120)
  slug            String  @unique @db.VarChar(120)
  iconUrl         String? @db.VarChar(1500)
  iconKey         String? @db.VarChar(1500)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  plans     Plan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

model TransportationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportations Transportation[]

  @@map("transportation_categories")
}

model AccommodationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodations Accommodation[]

  @@map("accommodation_categories")
}

model Product {
  id Int @id @default(autoincrement())

  name            String                     @db.VarChar(160)
  transactionType ProductTransactionTypeEnum @default(Sale)
  model           String?                    @db.VarChar(160)
  year            Int?
  price           Decimal                    @db.Decimal(10, 2)
  description     String?                    @db.LongText()
  imageUrl        String?                    @db.VarChar(1500)
  imageKey        String?                    @db.VarChar(1500)
  isActive        Boolean                    @default(true)
  categoryId      Int
  userId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category               ProductCategory         @relation(fields: [categoryId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  reviews                Review[]
  commercialTransactions CommercialTransaction[]
  rentals                Rental[]

  @@index([categoryId])
  @@index([userId])
  @@map("products")
}

model Transportation {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  model       String? @db.VarChar(160)
  mileageKm   Int?
  capacity    Int?
  year        Int?
  price       Decimal @db.Decimal(10, 2)
  description String? @db.LongText()
  imageUrl    String? @db.VarChar(1500)
  imageKey    String? @db.VarChar(1500)
  isActive    Boolean @default(true)
  categoryId  Int
  userId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          TransportationCategory @relation(fields: [categoryId], references: [id])
  user              User                   @relation(fields: [userId], references: [id])
  reviews           Review[]
  transportRequests TransportRequest[]

  @@index([categoryId])
  @@index([userId])
  @@map("transportations")
}

model Accommodation {
  id Int @id @default(autoincrement())

  name          String  @db.VarChar(160)
  addressId     Int?    @unique
  roomsQuantity Int?
  price         Decimal @db.Decimal(10, 2)
  description   String? @db.LongText()
  imageUrl      String? @db.VarChar(1500)
  imageKey      String? @db.VarChar(1500)
  isActive      Boolean @default(true)
  categoryId    Int
  userId        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address        Address?                    @relation(fields: [addressId], references: [id])
  category       AccommodationCategory       @relation(fields: [categoryId], references: [id])
  user           User                        @relation(fields: [userId], references: [id])
  reviews        Review[]
  bookings       Booking[]
  availabilities AccommodationAvailability[]

  @@index([addressId])
  @@index([categoryId])
  @@index([userId])
  @@map("accommodations")
}

model Address {
  id Int @id @default(autoincrement())

  street       String? @db.VarChar(160)
  neighborhood String? @db.VarChar(120)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(120)
  zipCode      String? @db.VarChar(20)
  number       String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation?
  subscriptions Subscription[]
  user          User?
  restaurant    Restaurant?
  foodOrders    FoodOrder[]

  @@map("addresses")
}

model BankAccount {
  id Int @id @default(autoincrement())

  bankName    String              @db.VarChar(120)
  accountType BankAccountTypeEnum
  agency      String              @db.VarChar(30)
  account     String              @db.VarChar(30)
  cpf         String              @db.VarChar(14)
  userId      Int                 @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("bank_accounts")
}

model Service {
  id Int @id @default(autoincrement())

  name             String          @db.VarChar(160)
  type             ServiceTypeEnum
  registrationCode String?         @db.VarChar(80)
  price            Decimal         @db.Decimal(10, 2)
  description      String?         @db.LongText()
  imageUrl         String?         @db.VarChar(1500)
  imageKey         String?         @db.VarChar(1500)
  isActive         Boolean         @default(true)
  categoryId       Int
  userId           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  budgets  Budget[]
  works    Work[]
  reviews  Review[]

  @@index([categoryId])
  @@index([userId])
  @@map("services")
}

model Review {
  id Int @id @default(autoincrement())

  type             ReviewTypeEnum
  comment          String?        @db.LongText()
  serviceId        Int?
  productId        Int?
  accommodationId  Int?
  transportationId Int?
  requesterId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service        Service?        @relation(fields: [serviceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  accommodation  Accommodation?  @relation(fields: [accommodationId], references: [id])
  transportation Transportation? @relation(fields: [transportationId], references: [id])
  requester      User            @relation(fields: [requesterId], references: [id])
  Restaurant     Restaurant?     @relation(fields: [restaurantId], references: [id])
  restaurantId   Int?

  @@unique([serviceId, requesterId])
  @@unique([productId, requesterId])
  @@unique([accommodationId, requesterId])
  @@unique([transportationId, requesterId])
  @@index([serviceId])
  @@index([productId])
  @@index([accommodationId])
  @@index([transportationId])
  @@index([requesterId])
  @@index([type])
  @@map("reviews")
}

model Budget {
  id Int @id @default(autoincrement())

  description             String?             @db.LongText()
  status                  BudgetStatusEnum    @default(Pending)
  responseDescription     String?             @db.LongText()
  responseValue           Decimal?            @db.Decimal(10, 2)
  extraRequestValue       Decimal?            @db.Decimal(10, 2)
  extraRequestDescription String?             @db.LongText()
  extraRequestStatus      ExtraRequestStatus?
  extraRequestedAt        DateTime?
  extraRespondedAt        DateTime?
  responseTimeQuantity    Int?
  responseTimeUnit        BudgetTimeUnitEnum?
  serviceId               Int?
  requesterId             Int
  providerId              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service             Service?            @relation(fields: [serviceId], references: [id])
  requester           User                @relation("BudgetRequester", fields: [requesterId], references: [id])
  provider            User                @relation("BudgetProvider", fields: [providerId], references: [id])
  files               BudgetFile[]
  informationRequests BudgetInformation[]
  work                Work?

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("budgets")
}

model BudgetFile {
  id Int @id @default(autoincrement())

  fileName             String             @db.VarChar(191)
  fileUrl              String             @db.VarChar(1500)
  fileKey              String             @db.VarChar(1500)
  type                 BudgetFileTypeEnum @default(Request)
  budgetId             Int
  informationRequestId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget             Budget             @relation(fields: [budgetId], references: [id])
  informationRequest BudgetInformation? @relation(fields: [informationRequestId], references: [id])

  @@index([budgetId])
  @@index([informationRequestId])
  @@map("budget_files")
}

model BudgetInformation {
  id Int @id @default(autoincrement())

  message  String @db.LongText()
  budgetId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget       @relation(fields: [budgetId], references: [id])
  files  BudgetFile[]

  @@index([budgetId])
  @@map("budget_information")
}

model Work {
  id Int @id @default(autoincrement())

  status                      WorkStatusEnum         @default(Pending)
  details                     String?                @db.LongText()
  completionDescription       String?                @db.LongText()
  cancelReason                String?                @db.LongText()
  serviceDate                 DateTime?
  startedAt                   DateTime?
  arrivalConfirmedAt          DateTime?
  finishedAt                  DateTime?
  cancelledAt                 DateTime?
  warrantyExpiresAt           DateTime?
  warrantyRequestedAt         DateTime?
  warrantyRequestDescription  String?                @db.LongText()
  warrantyRequestStatus       WarrantyRequestStatus?
  warrantyResponseDescription String?                @db.LongText()
  warrantyRespondedAt         DateTime?
  extraRequestValue           Decimal?               @db.Decimal(10, 2)
  extraRequestDescription     String?                @db.LongText()
  extraRequestStatus          ExtraRequestStatus?
  extraRequestedAt            DateTime?
  extraRespondedAt            DateTime?
  serviceValue                Decimal?               @db.Decimal(10, 2)
  totalValue                  Decimal?               @db.Decimal(10, 2)
  budgetId                    Int                    @unique
  serviceId                   Int
  requesterId                 Int
  providerId                  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget    Budget     @relation(fields: [budgetId], references: [id])
  service   Service    @relation(fields: [serviceId], references: [id])
  requester User       @relation("WorkRequester", fields: [requesterId], references: [id])
  provider  User       @relation("WorkProvider", fields: [providerId], references: [id])
  files     WorkFile[]

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("works")
}

model ChatRoom {
  id            Int             @id @default(autoincrement())
  contextType   ChatContextType
  referenceId   Int
  createdById   Int?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User?             @relation("ChatRoomCreator", fields: [createdById], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@unique([contextType, referenceId])
  @@index([createdById])
  @@index([contextType, referenceId])
  @@index([lastMessageAt])
  @@map("chat_rooms")
}

model ChatParticipant {
  id         Int       @id @default(autoincrement())
  roomId     Int
  userId     Int
  lastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id       Int     @id @default(autoincrement())
  roomId   Int
  senderId Int
  message  String? @db.LongText()
  fileName String? @db.VarChar(191)
  fileUrl  String? @db.VarChar(1500)
  fileKey  String? @db.VarChar(1500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
  @@map("chat_messages")
}

model CommercialTransaction {
  id Int @id @default(autoincrement())

  referenceType   CommercialTransactionReferenceTypeEnum
  referenceId     Int
  status          CommercialTransactionStatusEnum        @default(Requested)
  title           String?                                @db.VarChar(191)
  description     String?                                @db.LongText()
  requestedAmount Decimal                                @db.Decimal(10, 2)
  agreedAmount    Decimal?                               @db.Decimal(10, 2)
  buyerId         Int
  sellerId        Int
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  paidAt          DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer   User    @relation("CommercialTransactionBuyer", fields: [buyerId], references: [id])
  seller  User    @relation("CommercialTransactionSeller", fields: [sellerId], references: [id])
  product Product @relation(fields: [referenceId], references: [id])

  @@index([referenceType, referenceId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("commercial_transactions")
}

model Payment {
  id Int @id @default(autoincrement())

  method            PaymentMethodEnum?
  status            PaymentStatusEnum        @default(Pending)
  referenceType     PaymentReferenceTypeEnum
  referenceId       Int
  holderName        String?                  @db.VarChar(160)
  cardBrand         String?                  @db.VarChar(60)
  cardLast4         String?                  @db.VarChar(4)
  amount            Decimal                  @db.Decimal(10, 2)
  paidAt            DateTime?
  payerId           Int
  receiverId        Int
  externalReference String?                  @unique @db.VarChar(64)
  mpPreferenceId    String?                  @db.VarChar(120)
  mpPaymentId       String?                  @unique @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payer        User                   @relation("PaymentPayer", fields: [payerId], references: [id])
  receiver     User                   @relation("PaymentReceiver", fields: [receiverId], references: [id])
  transactions FinancialTransaction[]

  @@index([payerId])
  @@index([receiverId])
  @@index([referenceType, referenceId])
  @@index([status])
  @@map("payments")
}

model Plan {
  id            Int                      @id @default(autoincrement())
  name          String                   @db.VarChar(120)
  slug          String                   @unique @db.VarChar(120)
  description   String?                  @db.LongText()
  price         Decimal                  @db.Decimal(10, 2)
  interval      SubscriptionIntervalEnum
  intervalCount Int                      @default(1)
  bonusMonths   Int                      @default(0)
  isActive      Boolean                  @default(true)
  sortOrder     Int                      @default(0)

  categoryId Int?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("plans")
}

model Subscription {
  id                 Int                      @id @default(autoincrement())
  status             SubscriptionStatusEnum   @default(Pending)
  amount             Decimal                  @db.Decimal(10, 2)
  planName           String                   @db.VarChar(120)
  planInterval       SubscriptionIntervalEnum
  intervalCount      Int                      @default(1)
  startedAt          DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  bonusMonths        Int                      @default(0)
  userId             Int
  planId             Int
  addressId          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  plan    Plan     @relation(fields: [planId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([addressId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model FinancialTransaction {
  id Int @id @default(autoincrement())

  type          FinancialTransactionTypeEnum
  category      FinancialTransactionCategoryEnum
  status        PaymentStatusEnum                @default(Paid)
  amount        Decimal                          @db.Decimal(10, 2)
  description   String?                          @db.VarChar(255)
  availableAt   DateTime?
  referenceType PaymentReferenceTypeEnum
  referenceId   Int
  userId        Int
  paymentId     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([paymentId])
  @@index([referenceType, referenceId])
  @@index([type, status])
  @@map("financial_transactions")
}

model WorkFile {
  id Int @id @default(autoincrement())

  fileName String           @db.VarChar(191)
  fileUrl  String           @db.VarChar(1500)
  fileKey  String           @db.VarChar(1500)
  type     WorkFileTypeEnum @default(Requester)
  workId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id])

  @@index([workId])
  @@index([type])
  @@map("work_files")
}

model File {
  id Int @id @default(autoincrement())

  fileUrl String? @db.VarChar(1500)
  fileKey String? @db.VarChar(1500)
  userId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("files")
}

model Text {
  id Int @id @default(autoincrement())

  type TextType
  text String   @db.LongText()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("texts")
}

enum SocialNetworkEnum {
  Instagram
  TikTok
  YouTube
  Facebook
  X
  Other
}

enum Role {
  Master
  Admin
  User
}

enum UserProfileType {
  Client
  Supplier
  Delivery
  Influencer
}

enum Status {
  Active
  Pending
  Inactive
}

enum AdminPermissions {
  Dashboard
  Settings
  Services
  Financial
  Users
}

enum TextType {
  About
  Policies
  Terms
  Tips
  Cookies
}

enum ServiceTypeEnum {
  Online
  Presential
  Home
}

enum ProductTransactionTypeEnum {
  Rent
  Sale
  RentAndSale
}

enum BankAccountTypeEnum {
  Checking
  Savings
}

enum BudgetStatusEnum {
  Pending
  Responded
  WaitingInformation
  Cancelled
}

enum BudgetTimeUnitEnum {
  Hour
  Day
  Week
  Month
}

enum BudgetFileTypeEnum {
  Request
  InformationRequest
}

enum WorkStatusEnum {
  Pending
  InProgress
  Finished
  Cancelled
}

enum ChatContextType {
  Budget
  Work
  CommercialTransaction
  Rental
  TransportRequest
  Booking
  FoodOrder
  Job
}

enum PaymentMethodEnum {
  CreditCard
  Pix
  BankSlip
}

enum PaymentStatusEnum {
  Pending
  Paid
  Cancelled
}

enum PaymentReferenceTypeEnum {
  Work
  CommercialTransaction
  Subscription
  FoodOrder
  Referral
}

enum CommercialTransactionReferenceTypeEnum {
  Product
}

enum CommercialTransactionStatusEnum {
  Requested
  Accepted
  Rejected
  Cancelled
  Paid
  Completed
}

enum FinancialTransactionTypeEnum {
  Credit
  Debit
}

enum FinancialTransactionCategoryEnum {
  WorkPayment
  CommercialTransaction
  Subscription
  Fee
  Withdrawal
  Refund
  Adjustment
  DeliveryPayout
  ReferralCommission
}

enum SubscriptionIntervalEnum {
  Month
  Year
}

enum SubscriptionStatusEnum {
  Pending
  Active
  Cancelled
  Expired
}

enum WorkFileTypeEnum {
  Requester
  Provider
  Completion
  WarrantyRequest
}

enum WarrantyRequestStatus {
  Pending
  Approved
  Rejected
}

enum ExtraRequestStatus {
  Pending
  Approved
  Rejected
}

enum ReviewTypeEnum {
  Positive
  Negative
}

enum BillingTypeEnum {
  None
  Subscription
  Commission
}

model Referral {
  id               Int       @id @default(autoincrement())
  influencerId     Int
  referredUserId   Int       @unique
  isPaying         Boolean   @default(false)
  commissionAmount Decimal?  @db.Decimal(10, 2)
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  influencer   User @relation("InfluencerReferrals", fields: [influencerId], references: [id])
  referredUser User @relation("ReferredByInfluencer", fields: [referredUserId], references: [id])

  @@index([influencerId])
  @@map("referrals")
}

// ============================================================
// BE-01/BE-02 — Delivery: restaurantes, cardápio e pedidos
// ============================================================

model RestaurantCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]

  @@map("restaurant_categories")
}

model Restaurant {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  description String? @db.LongText()
  imageUrl    String? @db.VarChar(1500)
  imageKey    String? @db.VarChar(1500)
  isActive    Boolean @default(true)
  isOpen      Boolean @default(true)
  categoryId  Int
  userId      Int     @unique
  addressId   Int?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       RestaurantCategory @relation(fields: [categoryId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  address        Address?           @relation(fields: [addressId], references: [id])
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  foodOrders     FoodOrder[]
  reviews        Review[]

  @@index([categoryId])
  @@map("restaurants")
}

model MenuCategory {
  id Int @id @default(autoincrement())

  name         String @db.VarChar(120)
  sortOrder    Int    @default(0)
  restaurantId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id Int @id @default(autoincrement())

  name           String  @db.VarChar(160)
  description    String? @db.LongText()
  price          Decimal @db.Decimal(10, 2)
  imageUrl       String? @db.VarChar(1500)
  imageKey       String? @db.VarChar(1500)
  isActive       Boolean @default(true)
  restaurantId   Int
  menuCategoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id])
  menuCategory MenuCategory       @relation(fields: [menuCategoryId], references: [id])
  additions    MenuItemAddition[]
  orderItems   FoodOrderItem[]

  @@index([restaurantId])
  @@index([menuCategoryId])
  @@map("menu_items")
}

model MenuItemAddition {
  id Int @id @default(autoincrement())

  name       String  @db.VarChar(160)
  price      Decimal @default(0) @db.Decimal(10, 2)
  isActive   Boolean @default(true)
  menuItemId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem           MenuItem                @relation(fields: [menuItemId], references: [id])
  orderItemAdditions FoodOrderItemAddition[]

  @@index([menuItemId])
  @@map("menu_item_additions")
}

model FoodOrder {
  id Int @id @default(autoincrement())

  status           FoodOrderStatusEnum @default(Received)
  itemsValue       Decimal             @db.Decimal(10, 2)
  deliveryFee      Decimal             @default(0) @db.Decimal(10, 2)
  totalValue       Decimal             @db.Decimal(10, 2)
  platformFeeRate  Decimal?            @db.Decimal(5, 2)
  commissionAmount Decimal?            @db.Decimal(10, 2)
  paymentMethod    PaymentMethodEnum
  notes            String?             @db.LongText()
  cancelReason     String?             @db.LongText()
  restaurantId     Int
  customerId       Int
  addressId        Int?
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  deliveredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id])
  customer           User                @relation("FoodOrderCustomer", fields: [customerId], references: [id])
  address            Address?            @relation(fields: [addressId], references: [id])
  items              FoodOrderItem[]
  deliveryAssignment DeliveryAssignment?

  @@index([restaurantId])
  @@index([customerId])
  @@index([status])
  @@map("food_orders")
}

model FoodOrderItem {
  id Int @id @default(autoincrement())

  foodOrderId Int
  menuItemId  Int
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  notes       String? @db.VarChar(500)

  createdAt DateTime @default(now())

  foodOrder FoodOrder               @relation(fields: [foodOrderId], references: [id])
  menuItem  MenuItem                @relation(fields: [menuItemId], references: [id])
  additions FoodOrderItemAddition[]

  @@index([foodOrderId])
  @@index([menuItemId])
  @@map("food_order_items")
}

model FoodOrderItemAddition {
  id Int @id @default(autoincrement())

  foodOrderItemId    Int
  menuItemAdditionId Int
  price              Decimal @db.Decimal(10, 2)

  foodOrderItem    FoodOrderItem    @relation(fields: [foodOrderItemId], references: [id])
  menuItemAddition MenuItemAddition @relation(fields: [menuItemAdditionId], references: [id])

  @@index([foodOrderItemId])
  @@index([menuItemAdditionId])
  @@map("food_order_item_additions")
}

// ============================================================
// BE-03 — Entregador: aceite de pedidos e rastreamento
// ============================================================

model DeliveryAssignment {
  id Int @id @default(autoincrement())

  status            DeliveryAssignmentStatusEnum @default(Pending)
  foodOrderId       Int                          @unique
  courierId         Int?
  currentLat        Decimal?                     @db.Decimal(10, 7)
  currentLng        Decimal?                     @db.Decimal(10, 7)
  locationUpdatedAt DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id])
  courier   User?     @relation("DeliveryAssignmentCourier", fields: [courierId], references: [id])

  @@index([courierId])
  @@index([status])
  @@map("delivery_assignments")
}

// ============================================================
// BE-04 — Aluguel: entidade transacional
// ============================================================

model Rental {
  id Int @id @default(autoincrement())

  status       RentalStatusEnum @default(Requested)
  startDate    DateTime
  endDate      DateTime
  price        Decimal          @db.Decimal(10, 2)
  conditions   String?          @db.LongText()
  cancelReason String?          @db.LongText()
  productId    Int
  requesterId  Int
  providerId   Int
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  returnedAt   DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id])
  requester User    @relation("RentalRequester", fields: [requesterId], references: [id])
  provider  User    @relation("RentalProvider", fields: [providerId], references: [id])

  @@index([productId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("rentals")
}

// ============================================================
// BE-05 — Transporte: pedido de transporte
// ============================================================

model TransportRequest {
  id Int @id @default(autoincrement())

  status           TransportRequestStatusEnum @default(Requested)
  origin           String                     @db.VarChar(255)
  destination      String                     @db.VarChar(255)
  cargoDescription String?                    @db.LongText()
  quotedValue      Decimal?                   @db.Decimal(10, 2)
  cancelReason     String?                    @db.LongText()
  transportationId Int
  requesterId      Int
  providerId       Int
  quotedAt         DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportation Transportation @relation(fields: [transportationId], references: [id])
  requester      User           @relation("TransportRequestRequester", fields: [requesterId], references: [id])
  provider       User           @relation("TransportRequestProvider", fields: [providerId], references: [id])

  @@index([transportationId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("transport_requests")
}

// ============================================================
// BE-06 — Hospedagem: reserva e calendário de disponibilidade
// ============================================================

model Booking {
  id Int @id @default(autoincrement())

  status          BookingStatusEnum @default(Requested)
  checkIn         DateTime
  checkOut        DateTime
  guests          Int               @default(1)
  totalValue      Decimal           @db.Decimal(10, 2)
  cancelReason    String?           @db.LongText()
  accommodationId Int
  requesterId     Int
  providerId      Int
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  checkedInAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation @relation(fields: [accommodationId], references: [id])
  requester     User          @relation("BookingRequester", fields: [requesterId], references: [id])
  provider      User          @relation("BookingProvider", fields: [providerId], references: [id])

  @@index([accommodationId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

model AccommodationAvailability {
  id Int @id @default(autoincrement())

  accommodationId Int
  date            DateTime @db.Date
  isBlocked       Boolean  @default(true)
  reason          String?  @db.VarChar(255)

  createdAt DateTime @default(now())

  accommodation Accommodation @relation(fields: [accommodationId], references: [id])

  @@unique([accommodationId, date])
  @@index([accommodationId])
  @@map("accommodation_availabilities")
}

// ============================================================
// BE-07 — Empregos: vagas e candidaturas
// ============================================================

model Job {
  id Int @id @default(autoincrement())

  title        String      @db.VarChar(160)
  type         JobTypeEnum
  value        Decimal?    @db.Decimal(10, 2)
  requirements String?     @db.LongText()
  description  String?     @db.LongText()
  isActive     Boolean     @default(true)
  employerId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer     User             @relation("JobEmployer", fields: [employerId], references: [id])
  applications JobApplication[]

  @@index([employerId])
  @@index([isActive])
  @@map("jobs")
}

model JobApplication {
  id Int @id @default(autoincrement())

  status      JobApplicationStatusEnum @default(Applied)
  message     String?                  @db.LongText()
  jobId       Int
  applicantId Int
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job  @relation(fields: [jobId], references: [id])
  applicant User @relation("JobApplicant", fields: [applicantId], references: [id])

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@map("job_applications")
}

enum FoodOrderStatusEnum {
  Received
  Accepted
  Preparing
  OnTheWay
  Delivered
  Cancelled
}

enum DeliveryAssignmentStatusEnum {
  Pending
  Accepted
  Rejected
  PickedUp
  OnTheWay
  Delivered
  Cancelled
}

enum RentalStatusEnum {
  Requested
  Accepted
  Rejected
  Active
  Returned
  Cancelled
}

enum TransportRequestStatusEnum {
  Requested
  Quoted
  Accepted
  Rejected
  InTransit
  Delivered
  Cancelled
}

enum BookingStatusEnum {
  Requested
  Confirmed
  Rejected
  CheckedIn
  Completed
  Cancelled
}

enum JobTypeEnum {
  CLT
  PJ
  Freelance
  Temporary
}

enum JobApplicationStatusEnum {
  Applied
  Accepted
  Rejected
}
