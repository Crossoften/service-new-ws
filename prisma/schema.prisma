  user      User      @relation("CouponRedeemer", fields: [userId], references: [id])
  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum CouponTypeEnum {
