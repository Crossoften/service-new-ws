// ============================================================

/// Como o dinheiro saiu da plataforma para o entregador.
enum DeliveryPayoutMethodEnum {
  Pix
  BankTransfer
  Cash
  Other
}

/// Repasse pago ao entregador.
///
/// A plataforma retém frete e gorjeta no split e devia esses valores ao
/// entregador — dívida que até aqui existia só como crédito no razão, sem
/// nenhuma rotina que a liquidasse. Cada linha aqui é um pagamento que saiu de
/// verdade, com meio e comprovante, e amarra os créditos que ele quitou.
///
/// O pagamento em si acontece fora do sistema nesta etapa: o admin faz o Pix e
/// registra aqui. Automatizar o envio é etapa seguinte e não muda este modelo.
model DeliveryPayout {
  id Int @id @default(autoincrement())

  amount            Decimal                  @db.Decimal(10, 2)
  method            DeliveryPayoutMethodEnum
  /// Identificador do comprovante no banco: end-to-end do Pix, número da TED.
  reference         String?                  @db.VarChar(191)
  notes             String?                  @db.VarChar(255)
  /// Quantos créditos este lote quitou. Guardado em vez de contado depois
  /// porque o histórico precisa continuar correto se a regra mudar.
  transactionsCount Int                      @default(0)
  paidAt            DateTime
  courierId         Int
  createdById       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courier      User                   @relation("DeliveryPayoutCourier", fields: [courierId], references: [id])
  createdBy    User                   @relation("DeliveryPayoutCreator", fields: [createdById], references: [id])
  transactions FinancialTransaction[]

  @@index([courierId])
  @@index([paidAt])
  @@index([createdById])
  @@map("delivery_payouts")
}

model Rental {
  id Int @id @default(autoincrement())

  status       RentalStatusEnum @default(Requested)
  startDate    DateTime
  endDate      DateTime
  price        Decimal          @db.Decimal(10, 2)
  conditions   String?          @db.LongText()
  cancelReason String?          @db.LongText()
  productId    Int
  requesterId  Int
  providerId   Int
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  returnedAt   DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id])
  requester User    @relation("RentalRequester", fields: [requesterId], references: [id])
  provider  User    @relation("RentalProvider", fields: [providerId], references: [id])

  @@index([productId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("rentals")
}

// ============================================================
// BE-05 — Transporte: pedido de transporte
// ============================================================

model TransportRequest {
  id Int @id @default(autoincrement())

  status           TransportRequestStatusEnum @default(Requested)
  origin           String                     @db.VarChar(255)
  destination      String                     @db.VarChar(255)
  cargoDescription String?                    @db.LongText()
  quotedValue      Decimal?                   @db.Decimal(10, 2)
  cancelReason     String?                    @db.LongText()
  transportationId Int
  requesterId      Int
  providerId       Int
  quotedAt         DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportation Transportation @relation(fields: [transportationId], references: [id])
  requester      User           @relation("TransportRequestRequester", fields: [requesterId], references: [id])
  provider       User           @relation("TransportRequestProvider", fields: [providerId], references: [id])

  @@index([transportationId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("transport_requests")
}

// ============================================================
// BE-06 — Hospedagem: reserva e calendário de disponibilidade
// ============================================================

model Booking {
  id Int @id @default(autoincrement())

  status          BookingStatusEnum @default(Requested)
  checkIn         DateTime
  checkOut        DateTime
  guests          Int               @default(1)
  totalValue      Decimal           @db.Decimal(10, 2)
  cancelReason    String?           @db.LongText()
  accommodationId Int
  requesterId     Int
  providerId      Int
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  checkedInAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation @relation(fields: [accommodationId], references: [id])
  requester     User          @relation("BookingRequester", fields: [requesterId], references: [id])
  provider      User          @relation("BookingProvider", fields: [providerId], references: [id])

  @@index([accommodationId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

model AccommodationAvailability {
  id Int @id @default(autoincrement())

  accommodationId Int
  date            DateTime @db.Date
  isBlocked       Boolean  @default(true)
  reason          String?  @db.VarChar(255)

  createdAt DateTime @default(now())

  accommodation Accommodation @relation(fields: [accommodationId], references: [id])

  @@unique([accommodationId, date])
  @@index([accommodationId])
  @@map("accommodation_availabilities")
}

// ============================================================
// BE-07 — Empregos: vagas e candidaturas
// ============================================================

model Job {
  id Int @id @default(autoincrement())

  title        String      @db.VarChar(160)
  type         JobTypeEnum
  value        Decimal?    @db.Decimal(10, 2)
  requirements String?     @db.LongText()
  description  String?     @db.LongText()
  isActive     Boolean     @default(true)
  employerId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer     User             @relation("JobEmployer", fields: [employerId], references: [id])
  applications JobApplication[]

  @@index([employerId])
  @@index([isActive])
  @@map("jobs")
}

model JobApplication {
  id Int @id @default(autoincrement())

  status      JobApplicationStatusEnum @default(Applied)
  message     String?                  @db.LongText()
  jobId       Int
  applicantId Int
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job  @relation(fields: [jobId], references: [id])
  applicant User @relation("JobApplicant", fields: [applicantId], references: [id])

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@map("job_applications")
}

enum FoodOrderStatusEnum {
  Received
  Accepted
  Preparing
  OnTheWay
  Delivered
  Cancelled
}

enum DeliveryAssignmentStatusEnum {
  Pending
  Accepted
  Rejected
  PickedUp
  OnTheWay
  Delivered
  Cancelled
}

enum RentalStatusEnum {
  Requested
  Accepted
  Rejected
  Active
  Returned
  Cancelled
}

enum TransportRequestStatusEnum {
  Requested
  Quoted
  Accepted
  Rejected
  InTransit
  Delivered
  Cancelled
}

enum BookingStatusEnum {
  Requested
  Confirmed
  Rejected
  CheckedIn
  Completed
  Cancelled
}

enum JobTypeEnum {
  CLT
  PJ
  Freelance
  Temporary
}

enum JobApplicationStatusEnum {
  Applied
  Accepted
  Rejected
}
