generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name          String
  email         String    @unique
  document      String?   @unique @db.VarChar(18)
  biography     String?   @db.LongText()
  phone         String?   @unique
  password      String
  code          String?   @db.VarChar(4)
  codeExpiresIn DateTime?
  role          Role      @default(User)
  status        Status    @default(Pending)
  fileUrl       String?   @db.VarChar(1500)
  fileKey       String?   @db.VarChar(1500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPermissions      AdminPermission[]
  accommodations        Accommodation[]
  bankAccount           BankAccount?
  files                 File[]
  products              Product[]
  transportations       Transportation[]
  services              Service[]
  reviews               Review[]
  requestedBudgets      Budget[]               @relation("BudgetRequester")
  providedBudgets       Budget[]               @relation("BudgetProvider")
  requestedWorks        Work[]                 @relation("WorkRequester")
  sentPayments          Payment[]              @relation("PaymentPayer")
  financialTransactions FinancialTransaction[]
  providedWorks         Work[]                 @relation("WorkProvider")
  receivedPayments      Payment[]              @relation("PaymentReceiver")

  @@map("users")
}

model AdminPermission {
  id Int @id @default(autoincrement())

  name AdminPermissions @unique()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User[]

  @@map("admin_permissions")
}

model ServiceCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

model TransportationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportations Transportation[]

  @@map("transportation_categories")
}

model AccommodationCategory {
  id Int @id @default(autoincrement())

  name      String  @unique @db.VarChar(120)
  slug      String  @unique @db.VarChar(120)
  iconUrl   String? @db.VarChar(1500)
  iconKey   String? @db.VarChar(1500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodations Accommodation[]

  @@map("accommodation_categories")
}

model Product {
  id Int @id @default(autoincrement())

  name            String                 @db.VarChar(160)
  transactionType ProductTransactionType @default(Sale)
  model           String?                @db.VarChar(160)
  year            Int?
  price           Decimal                @db.Decimal(10, 2)
  description     String?                @db.LongText()
  imageUrl        String?                @db.VarChar(1500)
  imageKey        String?                @db.VarChar(1500)
  isActive        Boolean                @default(true)
  categoryId      Int
  userId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ProductCategory @relation(fields: [categoryId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([userId])
  @@map("products")
}

model Transportation {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  model       String? @db.VarChar(160)
  mileageKm   Int?
  capacity    Int?
  year        Int?
  price       Decimal @db.Decimal(10, 2)
  description String? @db.LongText()
  imageUrl    String? @db.VarChar(1500)
  imageKey    String? @db.VarChar(1500)
  isActive    Boolean @default(true)
  categoryId  Int
  userId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category TransportationCategory @relation(fields: [categoryId], references: [id])
  user     User                   @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([userId])
  @@map("transportations")
}

model Accommodation {
  id Int @id @default(autoincrement())

  name          String  @db.VarChar(160)
  street        String? @db.VarChar(160)
  neighborhood  String? @db.VarChar(120)
  city          String? @db.VarChar(120)
  state         String? @db.VarChar(120)
  roomsQuantity Int?
  price         Decimal @db.Decimal(10, 2)
  description   String? @db.LongText()
  imageUrl      String? @db.VarChar(1500)
  imageKey      String? @db.VarChar(1500)
  isActive      Boolean @default(true)
  categoryId    Int
  userId        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category AccommodationCategory @relation(fields: [categoryId], references: [id])
  user     User                  @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([userId])
  @@map("accommodations")
}

model BankAccount {
  id Int @id @default(autoincrement())

  bankName    String          @db.VarChar(120)
  accountType BankAccountType
  agency      String          @db.VarChar(30)
  account     String          @db.VarChar(30)
  cpf         String          @db.VarChar(14)
  userId      Int             @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("bank_accounts")
}

model Service {
  id Int @id @default(autoincrement())

  name             String      @db.VarChar(160)
  type             ServiceType
  registrationCode String?     @db.VarChar(80)
  price            Decimal     @db.Decimal(10, 2)
  description      String?     @db.LongText()
  imageUrl         String?     @db.VarChar(1500)
  imageKey         String?     @db.VarChar(1500)
  isActive         Boolean     @default(true)
  categoryId       Int
  userId           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  budgets  Budget[]
  works    Work[]
  reviews  Review[]

  @@index([categoryId])
  @@index([userId])
  @@map("services")
}

model Review {
  id Int @id @default(autoincrement())

  type        ReviewType
  comment     String?    @db.LongText()
  serviceId   Int
  requesterId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service   Service @relation(fields: [serviceId], references: [id])
  requester User    @relation(fields: [requesterId], references: [id])

  @@unique([serviceId, requesterId])
  @@index([serviceId])
  @@index([requesterId])
  @@index([type])
  @@map("reviews")
}

model Budget {
  id Int @id @default(autoincrement())

  description          String?         @db.LongText()
  status               BudgetStatus    @default(Pending)
  responseDescription  String?         @db.LongText()
  responseValue        Decimal?        @db.Decimal(10, 2)
  responseTimeQuantity Int?
  responseTimeUnit     BudgetTimeUnit?
  serviceId            Int?
  requesterId          Int
  providerId           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service             Service?            @relation(fields: [serviceId], references: [id])
  requester           User                @relation("BudgetRequester", fields: [requesterId], references: [id])
  provider            User                @relation("BudgetProvider", fields: [providerId], references: [id])
  files               BudgetFile[]
  informationRequests BudgetInformation[]
  work                Work?

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("budgets")
}

model BudgetFile {
  id Int @id @default(autoincrement())

  fileName             String         @db.VarChar(191)
  fileUrl              String         @db.VarChar(1500)
  fileKey              String         @db.VarChar(1500)
  type                 BudgetFileType @default(Request)
  budgetId             Int
  informationRequestId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget             Budget             @relation(fields: [budgetId], references: [id])
  informationRequest BudgetInformation? @relation(fields: [informationRequestId], references: [id])

  @@index([budgetId])
  @@index([informationRequestId])
  @@map("budget_files")
}

model BudgetInformation {
  id Int @id @default(autoincrement())

  message  String @db.LongText()
  budgetId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget       @relation(fields: [budgetId], references: [id])
  files  BudgetFile[]

  @@index([budgetId])
  @@map("budget_information")
}

model Work {
  id Int @id @default(autoincrement())

  status                WorkStatus @default(InProgress)
  details               String?    @db.LongText()
  completionDescription String?    @db.LongText()
  cancelReason          String?    @db.LongText()
  serviceDate           DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  cancelledAt           DateTime?
  serviceValue          Decimal?   @db.Decimal(10, 2)
  totalValue            Decimal?   @db.Decimal(10, 2)
  budgetId              Int        @unique
  serviceId             Int
  requesterId           Int
  providerId            Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget    Budget     @relation(fields: [budgetId], references: [id])
  service   Service    @relation(fields: [serviceId], references: [id])
  requester User       @relation("WorkRequester", fields: [requesterId], references: [id])
  provider  User       @relation("WorkProvider", fields: [providerId], references: [id])
  files     WorkFile[]

  @@index([serviceId])
  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("works")
}

model Payment {
  id Int @id @default(autoincrement())

  method        PaymentMethod
  status        PaymentStatus        @default(Paid)
  referenceType PaymentReferenceType
  referenceId   Int
  holderName    String?              @db.VarChar(160)
  cardBrand     String?              @db.VarChar(60)
  cardLast4     String?              @db.VarChar(4)
  amount        Decimal              @db.Decimal(10, 2)
  paidAt        DateTime?
  payerId       Int
  receiverId    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payer        User                   @relation("PaymentPayer", fields: [payerId], references: [id])
  receiver     User                   @relation("PaymentReceiver", fields: [receiverId], references: [id])
  transactions FinancialTransaction[]

  @@index([payerId])
  @@index([receiverId])
  @@index([referenceType, referenceId])
  @@index([status])
  @@map("payments")
}

model FinancialTransaction {
  id Int @id @default(autoincrement())

  type          FinancialTransactionType
  category      FinancialTransactionCategory
  status        PaymentStatus                @default(Paid)
  amount        Decimal                      @db.Decimal(10, 2)
  description   String?                      @db.VarChar(255)
  availableAt   DateTime?
  referenceType PaymentReferenceType
  referenceId   Int
  userId        Int
  paymentId     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([paymentId])
  @@index([referenceType, referenceId])
  @@index([type, status])
  @@map("financial_transactions")
}

model WorkFile {
  id Int @id @default(autoincrement())

  fileName String       @db.VarChar(191)
  fileUrl  String       @db.VarChar(1500)
  fileKey  String       @db.VarChar(1500)
  type     WorkFileType @default(Requester)
  workId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id])

  @@index([workId])
  @@index([type])
  @@map("work_files")
}

model File {
  id Int @id @default(autoincrement())

  fileUrl String? @db.VarChar(1500)
  fileKey String? @db.VarChar(1500)
  userId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("files")
}

model Text {
  id Int @id @default(autoincrement())

  type TextType
  text String   @db.LongText()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("texts")
}

enum Role {
  Master
  Admin
  User
  Supplier
}

enum Status {
  Active
  Pending
  Inactive
}

enum AdminPermissions {
  Dashboard
  Settings
  Services
  Financial
  Users
}

enum TextType {
  About
  Policies
  Terms
  Tips
  Cookies
}

enum ServiceType {
  Online
  Presential
  Home
}

enum ProductTransactionType {
  Rent
  Sale
  RentAndSale
}

enum BankAccountType {
  Checking
  Savings
}

enum BudgetStatus {
  Pending
  Responded
  WaitingInformation
  Cancelled
}

enum BudgetTimeUnit {
  Hour
  Day
  Week
  Month
}

enum BudgetFileType {
  Request
  InformationRequest
}

enum WorkStatus {
  InProgress
  Finished
  Cancelled
}

enum PaymentMethod {
  CreditCard
  Pix
  BankSlip
}

enum PaymentStatus {
  Pending
  Paid
  Cancelled
}

enum PaymentReferenceType {
  Work
}

enum FinancialTransactionType {
  Credit
  Debit
}

enum FinancialTransactionCategory {
  WorkPayment
  Fee
  Withdrawal
  Refund
  Adjustment
}

enum WorkFileType {
  Requester
  Provider
  Completion
}

enum ReviewType {
  Positive
  Negative
}
