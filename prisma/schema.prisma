model Coupon {
  id Int @id @default(autoincrement())

  code        String  @unique @db.VarChar(40)
  description String? @db.VarChar(255)

  type CouponTypeEnum

  /// Percentual (0–100) para `Percent`, valor em reais para `Fixed`.
  /// Nulo em `FreeShipping`, onde o desconto é o próprio frete do pedido.
  value Decimal? @db.Decimal(10, 2)

  /// Teto do desconto de um cupom percentual, em reais. Sem ele, "20% off" num
  /// pedido grande vira um desconto que a comissão não cobre.
  maxDiscountValue Decimal? @db.Decimal(10, 2)

  /// Valor mínimo dos itens para o cupom valer. É o mecanismo que mantém o
  /// desconto dentro da comissão do pedido.
  minOrderValue Decimal? @db.Decimal(10, 2)

  startsAt DateTime?
  endsAt   DateTime?

  /// Limite total de usos e limite por cliente. Nulos = sem limite.
  maxUses            Int?
  maxUsesPerCustomer Int?

  /// Restaurante ao qual o cupom se restringe. Nulo vale em todos.
  restaurantId Int?

  isActive    Boolean @default(true)
  createdById Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant?        @relation(fields: [restaurantId], references: [id])
  createdBy   User               @relation("CouponCreator", fields: [createdById], references: [id])
  redemptions CouponRedemption[]
  foodOrders  FoodOrder[]

  @@index([isActive])
  @@index([restaurantId])
  @@map("coupons")
}

/// Um resgate por pedido. É esta tabela que responde "quantas vezes este cupom
/// já foi usado" e "quantas vezes por este cliente" — contar em `FoodOrder`
/// misturaria pedido cancelado com pedido válido.
