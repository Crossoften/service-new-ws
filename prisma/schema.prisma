model FoodOrder {
  id Int @id @default(autoincrement())

  status           FoodOrderStatusEnum @default(Received)
  itemsValue       Decimal             @db.Decimal(10, 2)
  deliveryFee      Decimal             @default(0) @db.Decimal(10, 2)

  /// Gorjeta ao entregador, escolhida pelo cliente. Entra no total cobrado e
  /// vai inteira para o entregador — a plataforma não cobra comissão sobre ela.
  tip              Decimal             @default(0) @db.Decimal(10, 2)
  /// Desconto do cupom aplicado ao pedido. Sai do bolso da PLATAFORMA: o
  /// restaurante continua recebendo os itens integrais e o entregador continua
  /// recebendo frete e gorjeta. Por isso o desconto nunca pode passar da
  /// comissão daquele pedido — é só dela que há de onde tirar.
  discount         Decimal             @default(0) @db.Decimal(10, 2)
  couponId         Int?
  totalValue       Decimal             @db.Decimal(10, 2)
  platformFeeRate  Decimal?            @db.Decimal(5, 2)
  commissionAmount Decimal?            @db.Decimal(10, 2)
  paymentMethod    PaymentMethodEnum
  // Situação do pagamento do pedido. Até aqui não existia: o pedido guardava
  // o meio escolhido e nada dizia se o dinheiro entrou. Com `Cash` no enum,
  // alguém precisa confirmar o recebimento — não há gateway para fazer isso.
  paymentStatus    PaymentStatusEnum   @default(Pending)

  /// O dinheiro deste pedido não passa pela plataforma.
  ///
  /// Verdadeiro no pedido em dinheiro e no cartão cobrado na maquininha do
  /// próprio estabelecimento. Nos dois casos não há checkout, não há split,
  /// não há frete retido — e portanto **não há repasse a creditar ao
  /// entregador**, que recebe do estabelecimento.
  ///
  /// Gravado no pedido, e não deduzido do restaurante na hora de ler, porque a
  /// modalidade pode ser desligada depois: o pedido antigo tem de continuar
  /// contando a verdade do dia em que foi feito.
  settledOffPlatform Boolean          @default(false)

  /// Quando o cliente quer receber. Nulo é o pedido comum, para agora.
  /// Não altera o `status`: quem move o pedido pela cozinha continua sendo o
  /// restaurante, que usa este campo para separar o que é para já do que é
  /// para depois.
  scheduledFor     DateTime?
  paidAt           DateTime?
  paidConfirmedById Int?
  notes            String?             @db.LongText()
  cancelReason     String?             @db.LongText()
  restaurantId     Int
  customerId       Int
  addressId        Int?
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  deliveredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id])
  customer           User                @relation("FoodOrderCustomer", fields: [customerId], references: [id])
  paidConfirmedBy    User?               @relation("FoodOrderPaymentConfirmer", fields: [paidConfirmedById], references: [id])
  address            Address?            @relation(fields: [addressId], references: [id])
  coupon             Coupon?             @relation(fields: [couponId], references: [id])
  items              FoodOrderItem[]
  deliveryAssignment DeliveryAssignment?
  couponRedemption   CouponRedemption?

  @@index([restaurantId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("food_orders")
}

